[Unit]
Description=Onebox network rule restoration
After=network-online.target netfilter-persistent.service iptables.service ip6tables.service nftables.service firewalld.service ufw.service
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
Environment="ONEBOX_DIR=/etc/onebox"
Environment="ONEBOX_BIN_DIR=/opt/onebox/bin"
Environment="ONEBOX_LOG_DIR=/var/log/onebox"
Environment="ONEBOX_RUN_DIR=/run/onebox"
Environment="ONEBOX_SITE_ROOT=/var/lib/onebox-site"
Environment="ONEBOX_SYSTEMD_DIR=/etc/systemd/system"
Environment="ONEBOX_INITD_DIR=/etc/init.d"
Environment="ONEBOX_EXE=/usr/local/bin/onebox"
Environment="ONEBOX_FRPS_DIR=/etc/onebox-frp"
Environment="ONEBOX_FRPS_BIN_DIR=/opt/onebox-frp"
Environment="ONEBOX_FRPS_WEB_VAR=/var/lib/onebox-frp"
Environment="ONEBOX_FRPS_LOG_DIR=/var/log/onebox-frp"
Environment="ONEBOX_FRPS_RUN_DIR=/run/onebox-frp"
Environment="ONEBOX_INIT=systemd"
ExecStart="/usr/local/bin/onebox" "net-apply"
[Install]
WantedBy=multi-user.target
