  "sniffer": {
    "enable": true,
    "skip-domain": [
      "Mijia Cloud",
      "+.push.apple.com"
    ],
    "sniff": {
      "HTTP": {
        "override-destination": true,
        "ports": [
          80,
          "8080-8880"
        ]
      },
      "QUIC": {
        "ports": [
          443,
          8443
        ]
      },
      "TLS": {
        "ports": [
          443,
          8443
        ]
      }
    }
  },
  "tcp-concurrent": true,
  "tun": {
    "auto-detect-interface": true,
    "auto-route": true,
    "dns-hijack": [
      "any:53"
    ],
    "enable": false,
    "stack": "mixed"
  },
  "unified-delay": true
