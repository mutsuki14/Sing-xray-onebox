{
  "allow-lan": false,
  "dns": {
    "default-nameserver": [
      "223.5.5.5",
      "119.29.29.29"
    ],
    "enable": true,
    "enhanced-mode": "fake-ip",
    "fake-ip-filter": [
      "geosite:private",
      "geosite:connectivity-check",
      "+.lan",
      "+.local",
      "+.home.arpa",
      "time.*.com",
      "ntp.*.com",
      "+.pool.ntp.org",
      "+.stun.*.*",
      "+.stun.*.*.*",
      "+.srv.nintendo.net",
      "+.stun.playstation.net",
      "xbox.*.microsoft.com",
      "+.xboxlive.com"
