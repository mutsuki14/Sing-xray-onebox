          "publicKey": "2d3llZo1akCmI2rRkrsJHw0hh0cSPZMPiUVB9omYnEk",
          "serverName": "site.example.com",
          "shortId": "0123456789abcdef",
          "spiderX": "/"
        },
        "security": "reality"
      },
      "tag": "proxy"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "203.0.113.20",
            "port": 2083,
            "users": [
              {
                "encryption": "none",
                "id": "6f2c1d3e-8a4b-4c5d-8e6f-0a1b2c3d4e5f"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "grpcSettings": {
          "serviceName": "grpc0d1e2f"
        },
        "network": "grpc",
        "realitySettings": {
          "fingerprint": "chrome",
          "publicKey": "2d3llZo1akCmI2rRkrsJHw0hh0cSPZMPiUVB9omYnEk",
          "serverName": "site.example.com",
          "shortId": "0123456789abcdef",
          "spiderX": "/"
        },
        "security": "reality"
      },
      "tag": "vless-grpc"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "domain": [
          "full:site.example.com"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "ip": [
          "223.5.5.5"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "ip": [
          "0.0.0.0/8",
