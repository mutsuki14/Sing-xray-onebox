{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "blog.example.net",
          "sub.example.org"
        ],
        "server": "dns-direct"
      },
      {
        "clash_mode": "Direct",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Global",
        "server": "dns-remote"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns-direct"
      }
    ],
    "servers": [
      {
        "detour": "proxy",
        "server": "1.1.1.1",
        "tag": "dns-remote",
        "tls": {
          "server_name": "cloudflare-dns.com"
        },
        "type": "https"
      },
      {
        "server": "223.5.5.5",
        "tag": "dns-direct",
        "type": "udp"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9090",
      "secret": "0123456789abcdef0123456789abcdef0123456789abcdef"
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "stack": "mixed",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
    {
      "default": "auto",
      "outbounds": [
        "auto",
        "onebox-VLESS-gRPC-Reality",
        "onebox-VLESS-Reality-Vision",
        "onebox-VMess-WS",
        "direct"
      ],
      "tag": "proxy",
      "type": "selector"
    },
    {
      "interval": "3m",
      "outbounds": [
        "onebox-VLESS-gRPC-Reality",
        "onebox-VLESS-Reality-Vision",
        "onebox-VMess-WS"
      ],
      "tag": "auto",
      "tolerance": 50,
      "type": "urltest",
      "url": "https://www.gstatic.com/generate_204"
    },
    {
      "server": "203.0.113.30",
      "server_port": 443,
      "tag": "onebox-VLESS-gRPC-Reality",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "2d3llZo1akCmI2rRkrsJHw0hh0cSPZMPiUVB9omYnEk",
          "short_id": "0123456789abcdef"
        },
        "server_name": "blog.example.net",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "service_name": "grpc0d1e2f",
        "type": "grpc"
      },
      "type": "vless",
      "uuid": "6f2c1d3e-8a4b-4c5d-8e6f-0a1b2c3d4e5f"
    },
    {
      "flow": "xtls-rprx-vision",
      "server": "203.0.113.30",
      "server_port": 8443,
      "tag": "onebox-VLESS-Reality-Vision",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "2d3llZo1akCmI2rRkrsJHw0hh0cSPZMPiUVB9omYnEk",
          "short_id": "0123456789abcdef"
        },
        "server_name": "blog.example.net",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "type": "vless",
      "uuid": "6f2c1d3e-8a4b-4c5d-8e6f-0a1b2c3d4e5f"
    },
    {
      "alter_id": 0,
      "security": "auto",
      "server": "203.0.113.30",
      "server_port": 8080,
      "tag": "onebox-VMess-WS",
      "transport": {
        "early_data_header_name": "Sec-WebSocket-Protocol",
        "headers": {
          "Host": "cdn.example.net"
        },
        "max_early_data": 2048,
        "path": "/vm4d5e6f",
        "type": "ws"
      },
      "type": "vmess",
      "uuid": "6f2c1d3e-8a4b-4c5d-8e6f-0a1b2c3d4e5f"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "final": "proxy",
    "rule_set": [
      {
        "download_detour": "direct",
        "format": "binary",
        "tag": "geosite-cn",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs"
      },
      {
        "download_detour": "direct",
        "format": "binary",
        "tag": "geoip-cn",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "domain": [
          "blog.example.net",
          "sub.example.org"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "proxy"
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ]
      }
    ]
  }
}

