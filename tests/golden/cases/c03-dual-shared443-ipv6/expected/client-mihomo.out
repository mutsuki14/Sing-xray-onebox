  "proxy-groups": [
    {
      "name": "节点选择",
      "proxies": [
        "自动选择",
        "onebox-VLESS-Reality-Vision",
        "onebox-VLESS-XHTTP-Reality",
        "onebox-Hysteria2",
        "onebox-TUIC-v5",
        "onebox-AnyTLS",
        "onebox-Shadowsocks-2022",
        "DIRECT"
      ],
      "type": "select"
    },
    {
      "interval": 300,
      "name": "自动选择",
      "proxies": [
        "onebox-VLESS-Reality-Vision",
        "onebox-VLESS-XHTTP-Reality",
        "onebox-Hysteria2",
        "onebox-TUIC-v5",
        "onebox-AnyTLS",
        "onebox-Shadowsocks-2022"
      ],
      "tolerance": 50,
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204"
    }
  ],
  "rules": [
    "IP-CIDR6,2001:db8::10/128,DIRECT,no-resolve",
    "GEOSITE,private,DIRECT",
    "GEOIP,private,DIRECT,no-resolve",
    "GEOSITE,category-ads-all,REJECT",
    "GEOSITE,cn,DIRECT",
    "GEOSITE,geolocation-!cn,节点选择",
    "GEOIP,CN,DIRECT",
    "MATCH,节点选择"
  ],
  "secret": "0123456789abcdef0123456789abcdef0123456789abcdef",
  "sniffer": {
    "enable": true,
    "skip-domain": [
      "Mijia Cloud",
      "+.push.apple.com"
    ],
    "sniff": {
      "HTTP": {
        "override-destination": true,
        "ports": [
          80,
          "8080-8880"
        ]
      },
      "QUIC": {
        "ports": [
          443,
          8443
        ]
      },
      "TLS": {
        "ports": [
          443,
          8443
        ]
      }
    }
  },
  "tcp-concurrent": true,
  "tun": {
    "auto-detect-interface": true,
    "auto-route": true,
    "dns-hijack": [
      "any:53"
    ],
    "enable": false,
    "stack": "mixed"
  },
  "unified-delay": true
}

